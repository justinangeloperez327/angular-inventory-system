{
  "name": "angular-inventory-system",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run generate:build-info && ng build",
    "build:production": "npm run generate:build-info && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch --no-progress",
    "test:watch": "ng test",
    "check": "npm run check:dependencies && npm run check:api-contract && npm run check:design && npm run check:accessibility && npm run check:production && npm run check:runtime && npm run check:observability && npm run test && npm run build:production && npm run e2e",
    "check:design": "node scripts/check-design-system.mjs",
    "check:accessibility": "node scripts/check-accessibility.mjs",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "check:production": "node scripts/check-production.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:runtime": "node scripts/check-runtime-config.mjs",
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "check:observability": "node scripts/check-observability.mjs",
    "check:api-contract": "node scripts/check-api-contract.mjs",
    "e2e:full-stack": "playwright test --config playwright.full-stack.config.ts"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "npm@11.12.1"
}
